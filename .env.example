# Copy to .env and uncomment what you want to change; `docker compose up -d --wait` picks it up.
# The values shown are the defaults baked into compose.yaml.

# Drafter: lilicorr (NVIDIA's DGX Spark drafter, 7 tokens), mtp (the model's own MTP head, 5 tokens) or none.
#SPEC=lilicorr
# Draft length. Empty = 7 for lilicorr, 5 for mtp.
#SPEC_TOKENS=
# Tokens per sequence. The checkpoint's native window is 1M; only 8 of the 88 layers keep a KV cache.
#CONTEXT=1048576
# Concurrent sequences. The model card's Spark recipe uses 1.
#MAX_SEQS=1
# Share of the 121.6 GiB unified memory vLLM claims (weights ~70 GiB + drafter + KV + activations).
#GPU_UTIL=0.75
# Chunked-prefill size.
#BATCHED_TOKENS=8192

#SERVED_NAME=nemotron-3.5-super-vl
# A second model id the server answers to. Hermes on the Spark calls local-ai. Empty = none.
#ALIAS=local-ai
#HOST=0.0.0.0
#PORT=8888
# Bearer token, when set.
#API_KEY=

#VLLM_IMAGE=vllm/vllm-openai:nightly-3f1bcfd82bb2e93fcd364fc7a5491718453a77e2@sha256:cb9bc64f0f038c2c2ebf13b31248fb87aca40c356c3d20f363be087cfcff1fcd
#MODEL_ID=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
#MODEL_REVISION=2e5cc3953bb1ea66b2fb7c831fee3aa317427e69
#DRAFT_ID=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4-LiLiCorr
#DRAFT_REVISION=7c7221aeb4cb3139307aa457f7dce11a8fb6ceb2

#HF_CACHE=~/.cache/huggingface
#KERNEL_CACHE=~/.cache/nemotron-3.5-super-vl-dgx-spark
# Only needed if the model ever becomes gated.
#HF_TOKEN=
